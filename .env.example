# PostgreSQL connection string
DATABASE_URL=postgres://user:password@localhost:5432/auth_api?sslmode=disable

# Path to the RSA private key (PEM) used to sign the access tokens
JWT_PRIVATE_KEY_PATH=./private.pem

# HTTP server listen address
HTTP_ADDR=:8080

# Interval between cleanup runs of old refresh tokens (Go duration, e.g. 24h)
CLEANUP_INTERVAL=24h

# How long to keep expired refresh tokens before deleting them (Go duration)
EXPIRED_TOKEN_RETENTION=168h

# How long to keep revoked refresh tokens (Go duration; >= refresh TTL to preserve reuse detection)
REVOKED_TOKEN_RETENTION=720h

# Number of rows deleted per batch during cleanup
CLEANUP_BATCH_SIZE=1000

# Maximum number of batches per cleanup cycle
CLEANUP_MAX_BATCHES=100

# Timeout for a single cleanup cycle (Go duration)
CLEANUP_TIMEOUT=5m
